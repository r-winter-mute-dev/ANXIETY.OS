{
  "name": "anxiety-os",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "node scripts/release-guard.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "review": "node scripts/review-report.mjs",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Entwurf einer browserbasierten Selbsthilfe-Anwendung bei akuter Angst (nicht fachlich geprüft).",
  "license": "(MIT AND CC-BY-4.0)"
}
